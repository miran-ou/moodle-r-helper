{
  "manifest_version": 3,
  "name": "Moodle+R Helper",
  "version": "1.1.0",
  "description": "Moodle+Rの科目ページに、シラバスへのリンク・概要と、科目ごとの通知を追加する非公式拡張機能",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lms.ritsumei.ac.jp/*",
    "https://syllabus.ritsumei.ac.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.ritsumei.ac.jp/*",
        "https://syllabus.ritsumei.ac.jp/*"
      ],
      "js": [
        "tabs.js",
        "content.js",
        "notifications.js"
      ]
    }
  ]
}